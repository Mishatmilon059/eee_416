# Copy to .env and fill in. .env is gitignored -- never commit it.
#
#   cp .env.example .env
#
# Only the SECRET key belongs here. The publishable key already lives in
# web/config.js because the browser needs it, and it is safe there: RLS decides
# what it can actually do.

SUPABASE_URL=https://rufaacgatrebsyxnyfbq.supabase.co

# Publishable key -- same value as web/config.js. Used by tools/ so you do not
# have to keep the two in sync by hand.
SUPABASE_ANON_KEY=sb_publishable_lI3qv5Xk44GAhzL4R7I2GA_4k1aUar-

# SECRET key. Bypasses Row Level Security entirely: full read/write/delete on
# every table. Needed only if you lock down the select policy in schema.sql and
# still want tools/export_dataset.py to read rows.
#
# Anyone who obtains this owns the database. Do not paste it into chat, a
# screenshot, a slide, or a commit. If it leaks, rotate it immediately in
# Supabase -> Settings -> API Keys; rotation is instant and costs nothing.
SUPABASE_SERVICE_KEY=
